{
  "family": "${MIGRATE_TASK_FAMILY}",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "${MIGRATE_CPU}",
  "memory": "${MIGRATE_MEMORY}",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${MIGRATE_TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "${PROJECT}-api-migrate",
      "image": "${IMAGE_URI}",
      "essential": true,
      "command": ["sh", "/app/scripts/migrate.sh"],
      "environment": [
        { "name": "NODE_ENV", "value": "${NODE_ENV}" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "${SECRET_ARN_DATABASE_URL}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "${LOG_GROUP_NAME}",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "migrate"
        }
      }
    }
  ]
}
