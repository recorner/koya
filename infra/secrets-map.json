{
  "description": "Koya AWS Secrets Manager mapping. Maps logical secret names (env vars) to Secrets Manager paths.",
  "secrets": {
    "DATABASE_URL": {
      "path": "/koya/api/DATABASE_URL",
      "description": "PostgreSQL connection string",
      "required": true,
      "consumers": ["api", "migrate"]
    },
    "REDIS_PASSWORD": {
      "path": "/koya/api/REDIS_PASSWORD",
      "description": "Redis authentication password",
      "required": true,
      "consumers": ["api"]
    },
    "FX_API_KEY": {
      "path": "/koya/api/FX_API_KEY",
      "description": "Foreign exchange rate API key (exchangeratesapi.io)",
      "required": true,
      "consumers": ["api"]
    },
    "SLACK_WEBHOOK": {
      "path": "/koya/api/SLACK_WEBHOOK",
      "description": "Slack webhook URL for ops alerts",
      "required": false,
      "consumers": ["api"]
    },
    "MPESA_CONSUMER_KEY": {
      "path": "/koya/daraja/consumerKey",
      "description": "Safaricom Daraja consumer key",
      "required": true,
      "consumers": ["api"]
    },
    "MPESA_CONSUMER_SECRET": {
      "path": "/koya/daraja/consumerSecret",
      "description": "Safaricom Daraja consumer secret",
      "required": true,
      "consumers": ["api"]
    },
    "MPESA_PASSKEY": {
      "path": "/koya/daraja/passkey",
      "description": "Safaricom Daraja Lipa Na M-Pesa passkey",
      "required": true,
      "consumers": ["api"]
    },
    "DFNS_API_KEY": {
      "path": "/koya/dfns/apiKey",
      "description": "DFNS API key",
      "required": true,
      "consumers": ["api"]
    },
    "DFNS_MTLS_CERT": {
      "path": "/koya/dfns/mTlsCert",
      "description": "DFNS mTLS client certificate (PEM)",
      "required": false,
      "consumers": ["api"]
    },
    "DFNS_MTLS_KEY": {
      "path": "/koya/dfns/mTlsKey",
      "description": "DFNS mTLS client key (PEM)",
      "required": false,
      "consumers": ["api"]
    },
    "DFNS_WEBHOOK_SECRET": {
      "path": "/koya/dfns/webhookSecret",
      "description": "DFNS webhook HMAC-SHA256 secret",
      "required": true,
      "consumers": ["api"]
    },
    "BRIA_SIGNER_ENCRYPTION_KEY": {
      "path": "/koya/bria/signerEncryptionKey",
      "description": "Bria signer encryption key",
      "required": true,
      "consumers": ["bria"]
    },
    "BRIA_PG_CONNECTION": {
      "path": "/koya/bria/pgConnection",
      "description": "Bria PostgreSQL connection string",
      "required": true,
      "consumers": ["bria"]
    },
    "BRIA_API_KEY": {
      "path": "/koya/bria/apiKey",
      "description": "Bria API key",
      "required": true,
      "consumers": ["api"]
    },
    "TWILIO_ACCOUNT_SID": {
      "path": "/koya/twilio/accountSid",
      "description": "Twilio account SID",
      "required": false,
      "consumers": ["api"]
    },
    "TWILIO_AUTH_TOKEN": {
      "path": "/koya/twilio/authToken",
      "description": "Twilio auth token",
      "required": false,
      "consumers": ["api"]
    },
    "PAYLOAD_PREVIEW_USER_EMAIL": {
      "path": "/koya/payload/previewUserEmail",
      "description": "Payload preview service account email for web draft mode fetches",
      "required": true,
      "consumers": ["web"]
    },
    "PAYLOAD_PREVIEW_USER_PASSWORD": {
      "path": "/koya/payload/previewUserPassword",
      "description": "Payload preview service account password for web draft mode fetches",
      "required": true,
      "consumers": ["web"]
    },
    "KOYA_PREVIEW_SECRET": {
      "path": "/koya/web/previewSecret",
      "description": "Koya web preview endpoint secret",
      "required": true,
      "consumers": ["web"]
    },
    "KOYA_REVALIDATE_WEBHOOK_SECRET": {
      "path": "/koya/web/revalidateWebhookSecret",
      "description": "HMAC secret for signed Payload publish revalidation webhooks",
      "required": true,
      "consumers": ["web"]
    }
  }
}
