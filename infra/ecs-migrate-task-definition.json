{
  "family": "koya-api-migrate",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::286119371044:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::286119371044:role/koyaApiTaskRole",
  "containerDefinitions": [
    {
      "name": "koya-api-migrate",
      "image": "286119371044.dkr.ecr.us-east-1.amazonaws.com/koya/api:latest",
      "essential": true,
      "command": ["sh", "/app/scripts/migrate.sh"],
      "environment": [
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:286119371044:secret:/koya/api/DATABASE_URL-HyyV4E"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/koya-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "migrate"
        }
      }
    }
  ]
}
