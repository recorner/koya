# Bria Configuration — Example
# Copy to config/bria.yml and adjust for your environment.
#
# Docs: https://github.com/GaloyMoney/bria
# Network options: regtest, testnet, testnet4, signet, bitcoin (mainnet)

blockchain:
  network: testnet4
  # Remote Electrum-protocol server for UTXO indexing
  # Public testnet4 options: mempool.space:40002, blockstream.info:60601
  electrum_url: "mempool.space:40002"

api:
  listen_port: 2742

admin:
  listen_port: 2743

db:
  pool_size: 20
  migrate_on_start: true

tracing:
  host: "localhost"
  port: 4317
  service_name: "bria-koya"

jobs:
  sync_all_wallets_delay: 10
  process_all_payout_queues_delay: 10
  respawn_all_outbox_handlers_delay: 10
  signing:
    warn_retries: 2
    max_attempts: 5
    max_retry_delay: 3600

fees:
  mempool_space: {}

security:
  blocked_addresses: []
