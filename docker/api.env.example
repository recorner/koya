# Koya API — Docker Environment Variables
# Copy to api.env and fill in your values:
#   cp docker/api.env.example docker/api.env

NODE_ENV=production
API_PORT=3333

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/koya?sslmode=require

# CORS (comma-separated origins)
CORS_ORIGINS=https://koyabank.com,https://www.koyabank.com

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://api.koyabank.com/api/v1/payments/mpesa/callback
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# Rate Providers (defaults to public endpoints if omitted)
# Use data-api.binance.vision if api.binance.com is geo-blocked
BINANCE_API_URL=https://data-api.binance.vision
KRAKEN_API_URL=https://api.kraken.com
# FX: set FX_API_KEY to use Open Exchange Rates premium endpoint
# Leave blank to use free exchangerate-api.com (no key needed)
FX_API_URL=https://open.er-api.com/v6/latest/USD
# FX_API_KEY=your_openexchangerates_app_id

# BTC Delivery
BTC_DELIVERY_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Twilio (WhatsApp) — omit to use mock adapter
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_SESSION_TTL_MINUTES=10
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
WHATSAPP_WEBHOOK_URL=https://api.koyabank.com/api/v1/whatsapp/webhook

# AWS — S3 PSBT Archive (Step 16)
PSBT_ARCHIVE_S3_BUCKET=
PSBT_ARCHIVE_KMS_KEY_ID=
AWS_REGION=af-south-1

# AWS — CloudWatch Metrics (Step 16)
CLOUDWATCH_METRICS_ENABLED=false

# Security / Hardening (Step 20)
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_TTL_SECONDS=60
