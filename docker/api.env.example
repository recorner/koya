# Koya API — Docker Environment Variables
# Copy to api.env and fill in your values:
#   cp docker/api.env.example docker/api.env

NODE_ENV=production
API_PORT=3333

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/koya?sslmode=require

# CORS (comma-separated origins)
CORS_ORIGINS=https://koyabank.com,https://www.koyabank.com

# M-Pesa Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_CALLBACK_URL=https://api.koyabank.com/api/v1/payments/mpesa/callback
MPESA_PASSKEY=
MPESA_SHORTCODE=174379

# Rate Provider
RATE_PROVIDER_API_KEY=

# BTC Delivery
BTC_DELIVERY_API_KEY=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Twilio (WhatsApp) — omit to use mock adapter
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_SESSION_TTL_MINUTES=10
WHATSAPP_RATE_LIMIT_PER_MINUTE=20
WHATSAPP_WEBHOOK_URL=https://api.koyabank.com/api/v1/whatsapp/webhook
