# Koya Production Environment Configuration
# Non-secret values only. Secrets live in AWS Secrets Manager.
# Used by: scripts/load-env.sh, scripts/render-task-definitions.sh, Terraform

# ── AWS ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
ENVIRONMENT=production
PROJECT=koya
TF_STATE_BUCKET=koya-terraform-state

# ── Cluster / Service ────────────────────────────────────────────
ECS_CLUSTER_NAME=koya-production
ECS_SERVICE_NAME=koya-api-service-production
API_TASK_FAMILY=koya-api-production
MIGRATE_TASK_FAMILY=koya-api-migrate-production
BRIA_ECS_SERVICE_NAME=koya-bria-service-production
BRIA_TASK_FAMILY=koya-bria-production
BRIA_IMAGE_TAG=latest

# ── Container ────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
API_CPU=512
API_MEMORY=1024
MIGRATE_CPU=256
MIGRATE_MEMORY=512
BRIA_CPU=512
BRIA_MEMORY=1024
BRIA_PORT=2742
BRIA_ADMIN_PORT=2743
DESIRED_COUNT=2
ASSIGN_PUBLIC_IP=false

# ── Application Config ───────────────────────────────────────────
MPESA_SHORTCODE=174379
MPESA_DRIVER=daraja
MPESA_ENVIRONMENT=production
BTC_DELIVERY_DRIVER=bria
BTC_NETWORK=testnet4
MESSAGING_ENABLE_WHATSAPP_CLOUD=true
MESSAGING_ENABLE_TELEGRAM=true
MESSAGING_MAX_RETRIES=4
MESSAGING_RETRY_BASE_MS=1200
WHATSAPP_PHONE_NUMBER_ID=1081736995024877
WHATSAPP_CLOUD_API_VERSION=v21.0
TELEGRAM_ALLOWED_IPS=
CORS_ORIGINS=https://koyabank.com,https://www.koyabank.com

# ── External Services ────────────────────────────────────────────
REDIS_HOST=redis.koyabank.com
REDIS_PORT=6379
REDIS_TLS=true
REDIS_DB=0
BRIA_API_HOST=koya-bria.koya.internal
BRIA_API_PORT=2742
DFNS_API_URL=https://api.dfns.io/v2
DFNS_APP_ID=
DFNS_SERVICE_ACCOUNT=
DFNS_WALLET_ID=

# ── Callback URLs ────────────────────────────────────────────────
MPESA_CALLBACK_URL=https://api.koyabank.com/api/v1/payments/mpesa/callback
DFNS_WEBHOOK_URL=https://api.koyabank.com/api/v1/dfns/webhook
WHATSAPP_WEB_BASE_URL=https://koyabank.com

# ── Bria ─────────────────────────────────────────────────────────
# Bria v0.1.131 does not reliably recognize `testnet4` and may fall back to regtest.
# Keep API network enforcement on testnet4, but run Bria daemon with `testnet`.
BRIA_NETWORK=testnet
BRIA_ELECTRUM_URL=mempool.space:40002
BRIA_WALLET_NAME=koya-testnet4-v2
BRIA_PAYOUT_QUEUE=koya-payouts
BRIA_PAYOUT_QUEUE_NAME=koya-payouts
BRIA_XPUB_REF=koya-testnet4-signer
BRIA_STREAM_RECONNECT_BASE_MS=1000
BRIA_STREAM_RECONNECT_MAX_MS=30000
BRIA_STREAM_RECONNECT_JITTER_MS=500

# ── Storage ──────────────────────────────────────────────────────
PSBT_ARCHIVE_S3_BUCKET=koya-archives-prod

# ── Hardening ────────────────────────────────────────────────────
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb
THROTTLE_DEFAULT_LIMIT=60
THROTTLE_DEFAULT_TTL_SECONDS=60
CLOUDWATCH_METRICS_ENABLED=true

# ── Autoscaling ──────────────────────────────────────────────────
AUTOSCALING_MIN_CAPACITY=2
AUTOSCALING_MAX_CAPACITY=10
AUTOSCALING_CPU_TARGET=60
AUTOSCALING_MEMORY_TARGET=70
AUTOSCALING_REQUEST_COUNT_TARGET=500

# ── WAF ──────────────────────────────────────────────────────────
WAF_GLOBAL_RATE_LIMIT=2000
WAF_CONVERSION_RATE_LIMIT=500
WAF_WEBHOOK_RATE_LIMIT=1000

# ── Release Identity ─────────────────────────────────────────────
RELEASE_FAMILY=euclide
RELEASE_VERSION=1.1.001

# ── DNS ──────────────────────────────────────────────────────────
DOMAIN_NAME=koyabank.com
API_SUBDOMAIN=api
ROUTE53_ZONE_ID=

# ── Alarms ───────────────────────────────────────────────────────
ALARM_429_THRESHOLD=50
ALARM_5XX_THRESHOLD=10
ALARM_LATENCY_THRESHOLD_MS=5000
ALARM_REQUEST_COUNT_THRESHOLD=10000
ALARM_WAF_BLOCK_THRESHOLD=100
OPS_NOTIFICATION_ENDPOINT=https://hooks.slack.com/services/PLACEHOLDER
ONEUPTIME_NOTIFICATION_ENDPOINT=https://oneuptime.com/api/webhook/PLACEHOLDER
