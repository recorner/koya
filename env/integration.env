# Koya Integration (Local Docker) Environment Configuration
# Non-secret values only. Secrets come from .env.local for local dev.
# Used by: scripts/load-env.sh, docker compose

# ── AWS (not used for local, but required by env loader) ─────────
AWS_REGION=us-east-1
ENVIRONMENT=integration
PROJECT=koya
TF_STATE_BUCKET=

# ── Cluster / Service (not used locally) ─────────────────────────
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=
API_TASK_FAMILY=
MIGRATE_TASK_FAMILY=

# ── Container ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3333
API_CPU=512
API_MEMORY=1024
MIGRATE_CPU=256
MIGRATE_MEMORY=512
DESIRED_COUNT=1
ASSIGN_PUBLIC_IP=false

# ── Application Config ───────────────────────────────────────────
MPESA_SHORTCODE=174379
MPESA_DRIVER=mock
MPESA_ENVIRONMENT=sandbox
BTC_DELIVERY_DRIVER=mock
MESSAGING_ENABLE_WHATSAPP_CLOUD=true
MESSAGING_ENABLE_TELEGRAM=true
MESSAGING_MAX_RETRIES=4
MESSAGING_RETRY_BASE_MS=1200
CORS_ORIGINS=http://localhost:3000,http://localhost:3333

# ── External Services ────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_DB=0
BRIA_API_HOST=localhost
BRIA_API_PORT=2742
DFNS_API_URL=https://api.dfns.ninja/v2
DFNS_APP_ID=
DFNS_WALLET_ID=

# ── Callback URLs ────────────────────────────────────────────────
MPESA_CALLBACK_URL=http://localhost:3333/api/v1/payments/mpesa/callback
DFNS_WEBHOOK_URL=http://localhost:3333/api/v1/dfns/webhook
WHATSAPP_WEB_BASE_URL=http://localhost:3000

# ── Bria ─────────────────────────────────────────────────────────
BRIA_WALLET_NAME=koya-testnet
BRIA_PAYOUT_QUEUE_NAME=koya-payouts
BRIA_XPUB_REF=koya-testnet-xpub

# ── Storage ──────────────────────────────────────────────────────
PSBT_ARCHIVE_S3_BUCKET=

# ── Hardening ────────────────────────────────────────────────────
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb
THROTTLE_DEFAULT_LIMIT=1000
THROTTLE_DEFAULT_TTL_SECONDS=60
CLOUDWATCH_METRICS_ENABLED=false

# ── Autoscaling (not used locally) ───────────────────────────────
AUTOSCALING_MIN_CAPACITY=1
AUTOSCALING_MAX_CAPACITY=1
AUTOSCALING_CPU_TARGET=60
AUTOSCALING_MEMORY_TARGET=70
AUTOSCALING_REQUEST_COUNT_TARGET=500

# ── WAF (not used locally) ───────────────────────────────────────
WAF_GLOBAL_RATE_LIMIT=2000
WAF_CONVERSION_RATE_LIMIT=500
WAF_WEBHOOK_RATE_LIMIT=1000

# ── Release Identity ─────────────────────────────────────────────
RELEASE_FAMILY=euclide
RELEASE_VERSION=1.1.001

# ── DNS (not used locally) ───────────────────────────────────────
DOMAIN_NAME=localhost
API_SUBDOMAIN=
ROUTE53_ZONE_ID=

# ── Alarms (not used locally) ────────────────────────────────────
ALARM_429_THRESHOLD=50
ALARM_5XX_THRESHOLD=10
ALARM_LATENCY_THRESHOLD_MS=5000
ALARM_REQUEST_COUNT_THRESHOLD=10000
ALARM_WAF_BLOCK_THRESHOLD=100
OPS_NOTIFICATION_ENDPOINT=
ONEUPTIME_NOTIFICATION_ENDPOINT=
