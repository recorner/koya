# Koya — Environment Variables
# Copy to .env.local and fill in values

# API
NEXT_PUBLIC_API_URL=https://api.koyabank.com/api/v1
NEXT_PUBLIC_APP_URL=https://koyabank.com

# Payload CMS (web)
# Prefer PAYLOAD_API_URL as full API base, e.g. https://payload.koyabank.com/api
PAYLOAD_API_URL=https://payload.koyabank.com/api
PAYLOAD_TIMEOUT_MS=5000
PAYLOAD_PREVIEW_USER_EMAIL=preview-bot@koyabank.com
PAYLOAD_PREVIEW_USER_PASSWORD=replace-with-preview-user-password
KOYA_PREVIEW_SECRET=replace-with-preview-secret
KOYA_REVALIDATE_WEBHOOK_SECRET=replace-with-webhook-secret
KOYA_REVALIDATE_MAX_SKEW_MS=300000

# Release Identity
NEXT_PUBLIC_APP_VERSION=1.1.001
NEXT_PUBLIC_RELEASE_NAME=euclide

# NestJS
PORT=3333
NODE_ENV=development

# Database (DigitalOcean Managed PostgreSQL)
DATABASE_URL="postgresql://username:password@host:port/koya?sslmode=require&sslaccept=accept_invalid_certs&connect_timeout=30"

# CORS (additional origins, comma-separated)
# CORS_ORIGINS=

# M-Pesa (mock values — replace with Safaricom Daraja sandbox creds)
MPESA_CONSUMER_KEY=mock_consumer_key
MPESA_CONSUMER_SECRET=mock_consumer_secret
MPESA_CALLBACK_URL=https://api.koyabank.com/api/v1/payments/mpesa/callback
MPESA_PASSKEY=mock_passkey
MPESA_SHORTCODE=174379

# Rate Provider (mock — replace with real FX API key)
RATE_PROVIDER_API_KEY=mock_rate_key

# BTC Delivery (mock — replace with custody provider creds)
BTC_DELIVERY_API_KEY=mock_btc_key

# Messaging Providers
MESSAGING_ENABLE_WHATSAPP_CLOUD=true
MESSAGING_ENABLE_TELEGRAM=true
MESSAGING_MAX_RETRIES=4
MESSAGING_RETRY_BASE_MS=1200

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_meta_verify_token
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_CLOUD_API_VERSION=v21.0

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret
TELEGRAM_ALLOWED_IPS=

# WhatsApp settings
WHATSAPP_WEB_BASE_URL=https://koyabank.com
WHATSAPP_SESSION_TTL_MINUTES=10
