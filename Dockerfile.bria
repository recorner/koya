# Bria — private runtime wrapper image
# Base the binary on upstream Galoy Bria image, then add runtime templating and entrypoint.

FROM us.gcr.io/galoy-org/bria:0.1.131 AS upstream

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gettext-base netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1001 bria \
    && useradd -u 1001 -g bria -d /bria -m -s /usr/sbin/nologin bria

COPY --from=upstream /usr/bin/bria /usr/local/bin/bria
COPY config/bria.runtime.yml.tpl /etc/bria/bria.yml.tpl
COPY docker/bria-entrypoint.sh /usr/local/bin/bria-entrypoint.sh

RUN chmod +x /usr/local/bin/bria \
    && chmod +x /usr/local/bin/bria-entrypoint.sh \
    && mkdir -p /bria \
    && chown -R bria:bria /bria

ENV BRIA_HOME=/bria
ENV BRIA_CONFIG=/tmp/bria.yml
ENV BRIA_CONFIG_TEMPLATE=/etc/bria/bria.yml.tpl
ENV RUST_LOG=info

EXPOSE 2742 2743

USER bria
WORKDIR /bria

# PG_CON and SIGNER_ENCRYPTION_KEY are injected from Secrets Manager at runtime.
ENTRYPOINT ["/usr/local/bin/bria-entrypoint.sh"]
