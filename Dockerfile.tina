# ─── Stage 1: Install dependencies ──────────────────────────────
FROM node:22-alpine AS deps

RUN corepack enable && corepack prepare pnpm@10.32.0 --activate

WORKDIR /app

# Copy workspace config files needed for install
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY libs/types/package.json libs/types/
COPY libs/config/package.json libs/config/
COPY libs/ui/package.json libs/ui/

# Copy Prisma schema — postinstall runs prisma generate
COPY apps/api/prisma/schema.prisma apps/api/prisma/
COPY apps/api/prisma/prisma.config.ts apps/api/prisma/

RUN pnpm install --frozen-lockfile

# ─── Stage 2: Build ────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@10.32.0 --activate

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build TinaCMS admin (generates admin UI + schema artifacts)
RUN cd apps/web && npx tinacms build --local --skip-cloud-checks

# Build Next.js with standalone output
RUN cd apps/web && npx next build

# ─── Stage 3: Production ───────────────────────────────────────
FROM node:22-alpine AS runner

# Security: run as non-root
RUN addgroup --system --gid 1001 koya && \
    adduser --system --uid 1001 koya

WORKDIR /app

# Copy standalone server (includes minimal node_modules)
COPY --from=builder /app/apps/web/.next/standalone/apps/web ./
COPY --from=builder /app/apps/web/.next/standalone/node_modules ./node_modules

# Copy static assets (Next.js standalone doesn't include these)
COPY --from=builder /app/apps/web/.next/static ./.next/static
COPY --from=builder /app/apps/web/public ./public

# Copy TinaCMS generated schema for runtime indexing
COPY --from=builder /app/apps/web/tina/__generated__ ./tina/__generated__

# Copy auth module (users.json is volume-mounted at runtime)
COPY --from=builder /app/apps/web/tina/auth ./tina/auth

# Content files (editable at runtime via volume mount)
COPY --from=builder /app/apps/web/content ./content

USER koya

ENV NODE_ENV=production
ENV TINA_PUBLIC_IS_LOCAL=true
ENV PORT=3001
ENV HOSTNAME=0.0.0.0

EXPOSE 3001

CMD ["node", "server.js"]
