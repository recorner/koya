generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────

enum ConversionState {
  INTENT_CAPTURED
  QUOTE_PENDING
  QUOTE_READY
  QUOTE_CONFIRMED
  IDENTITY_PENDING
  COMPLIANCE_PENDING
  PAYOUT_DETAILS_PENDING
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  EXECUTION_PENDING
  DELIVERY_PENDING
  COMPLETED
  FAILED
  EXPIRED
  MANUAL_REVIEW
}

enum Channel {
  WEB
  WHATSAPP
  TELEGRAM
}

enum GuestStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  BLOCKED
}

enum QuoteStatus {
  PENDING
  READY
  CONFIRMED
  EXPIRED
  FAILED
}

enum PaymentInstructionStatus {
  CREATED
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PayoutInstructionStatus {
  CREATED
  PENDING_DISPATCH
  PENDING
  CONFIRMED
  FAILED
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  FAILED
  EXPIRED
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  ALIEN_ID
  MILITARY_ID
}

enum WhatsAppFlowStep {
  IDLE
  MENU
  WAITING_FOR_AMOUNT
  WAITING_FOR_QUOTE_CONFIRMATION
  WAITING_FOR_FULL_NAME
  WAITING_FOR_DOCUMENT_NUMBER
  WAITING_FOR_EMAIL
  WAITING_FOR_BTC_ADDRESS
  WAITING_FOR_PAYMENT_CONFIRMATION
  WAITING_FOR_REFERENCE
  PROCESSING
  COMPLETED
}

enum WhatsAppConversationStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessagingProvider {
  WHATSAPP_CLOUD
  TELEGRAM
}

enum MessagingEventType {
  INBOUND_MESSAGE
  PROVIDER_STATUS
  SYSTEM
}

enum MessagingEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum MessagingDeliveryState {
  SENT
  FAILED
  RETRYING
  DEAD_LETTER
}

// ─── Models ───────────────────────────────────────────────────────

model GuestProfile {
  id                       String   @id @default(uuid())
  guestRef                 String   @unique @map("guest_ref")
  fullName                 String   @map("full_name")
  countryCode              String   @map("country_code")
  documentType             DocumentType @map("document_type")
  documentNumberNormalized String   @map("document_number_normalized")
  phoneE164                String   @map("phone_e164")
  email                    String?
  status                   GuestStatus @default(ACTIVE)
  riskLevel                RiskLevel @default(LOW)
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  sessions ConversionSession[]

  @@unique([countryCode, documentType, documentNumberNormalized], name: "identity_dedupe")
  @@map("guest_profiles")
}

model ConversionSession {
  id               String          @id @default(uuid())
  channel          Channel
  guestProfileId   String?         @map("guest_profile_id")
  currentState     ConversionState @default(INTENT_CAPTURED) @map("current_state")
  status           SessionStatus   @default(ACTIVE)
  sourceAsset      String          @map("source_asset")
  targetAsset      String          @map("target_asset")
  sourceAmountMinor BigInt         @map("source_amount_minor")
  quotedTargetAmountMinor BigInt?  @map("quoted_target_amount_minor")
  quoteId          String?         @map("quote_id")
  routePolicyKey   String          @map("route_policy_key")
  payinMethod      String          @map("payin_method")
  payoutMethod     String          @map("payout_method")
  referenceCode    String          @unique @map("reference_code")
  expiresAt        DateTime?       @map("expires_at")
  metadataJson     Json?           @map("metadata_json")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  guestProfile       GuestProfile?       @relation(fields: [guestProfileId], references: [id])
  quote              ConversionQuote?    @relation(fields: [quoteId], references: [id])
  paymentInstruction PaymentInstruction?
  payoutInstruction  PayoutInstruction?
  btcDepositAddresses BtcDepositAddress[]
  stateEvents        ConversionStateEvent[]
  whatsappConversation WhatsAppConversation?

  @@index([guestProfileId])
  @@index([referenceCode])
  @@map("conversion_sessions")
}

model ConversionQuote {
  id              String      @id @default(uuid())
  sourceAsset     String      @map("source_asset")
  targetAsset     String      @map("target_asset")
  sourceAmountMinor BigInt    @map("source_amount_minor")
  targetAmountMinor BigInt    @map("target_amount_minor")
  rate            Decimal     @db.Decimal(30, 18)
  spread          Decimal     @db.Decimal(10, 6)
  feeMinor        BigInt      @map("fee_minor")
  feeCurrency     String      @map("fee_currency")
  status          QuoteStatus @default(PENDING)
  expiresAt       DateTime    @map("expires_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sessions ConversionSession[]

  @@map("conversion_quotes")
}

model PaymentInstruction {
  id                   String                   @id @default(uuid())
  conversionSessionId  String                   @unique @map("conversion_session_id")
  provider             String                   @default("MPESA")
  instructionType      String                   @default("STK_PUSH") @map("instruction_type")
  phoneE164            String                   @map("phone_e164")
  amountMinor          BigInt                   @map("amount_minor")
  currency             String                   @default("KES")
  externalReference    String?                  @map("external_reference")
  merchantRequestId    String?                  @map("merchant_request_id")
  checkoutRequestId    String?                  @unique @map("checkout_request_id")
  mpesaReceiptNumber   String?                  @map("mpesa_receipt_number")
  status               PaymentInstructionStatus @default(CREATED)
  rawCallbackPayload   Json?                    @map("raw_callback_payload")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  session ConversionSession @relation(fields: [conversionSessionId], references: [id])

  @@map("payment_instructions")
}

model PayoutInstruction {
  id                  String                  @id @default(uuid())
  conversionSessionId String                  @unique @map("conversion_session_id")
  destinationType     String                  @default("BTC_ADDRESS") @map("destination_type")
  btcAddress          String                  @map("btc_address")
  amountMinor         BigInt?                 @map("amount_minor")
  txHash              String?                 @map("tx_hash")
  externalId          String?                 @unique @map("external_id")
  providerPayoutId    String?                 @map("provider_payout_id")
  dispatchAttempts    Int                     @default(0) @map("dispatch_attempts")
  nextDispatchAt      DateTime?               @map("next_dispatch_at")
  lastDispatchError   String?                 @map("last_dispatch_error")
  status              PayoutInstructionStatus @default(CREATED)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  session ConversionSession @relation(fields: [conversionSessionId], references: [id])

  @@map("payout_instructions")
}

model BtcDepositAddress {
  id                  String            @id @default(uuid())
  backend             String
  btcNetwork          String            @map("btc_network")
  walletName          String?           @map("wallet_name")
  address             String            @unique
  externalId          String            @unique @map("external_id")
  businessContextType String            @map("business_context_type")
  businessContextRef  String            @map("business_context_ref")
  conversionSessionId String?           @map("conversion_session_id")
  metadataJson        Json?             @map("metadata_json")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  conversionSession ConversionSession? @relation(fields: [conversionSessionId], references: [id])

  @@index([businessContextType, businessContextRef], map: "btc_deposit_addresses_context_idx")
  @@index([conversionSessionId], map: "btc_deposit_addresses_session_idx")
  @@map("btc_deposit_addresses")
}

model ConversionStateEvent {
  id                  String          @id @default(uuid())
  conversionSessionId String          @map("conversion_session_id")
  fromState           ConversionState? @map("from_state")
  toState             ConversionState @map("to_state")
  trigger             String
  metadataJson        Json?           @map("metadata_json")
  createdAt           DateTime        @default(now()) @map("created_at")

  session ConversionSession @relation(fields: [conversionSessionId], references: [id])

  @@index([conversionSessionId])
  @@map("conversion_state_events")
}

// ─── WhatsApp Models ──────────────────────────────────────────────

model WhatsAppConversation {
  id                  String                     @id @default(uuid())
  phoneNumber         String                     @map("phone_number")
  provider            MessagingProvider          @default(WHATSAPP_CLOUD)
  status              WhatsAppConversationStatus  @default(ACTIVE)
  currentStep         WhatsAppFlowStep            @default(IDLE) @map("current_step")
  conversionSessionId String?                    @unique @map("conversion_session_id")
  quoteId             String?                    @map("quote_id")
  metadata            Json?
  lastInboundAt       DateTime                   @map("last_inbound_at")
  lastOutboundAt      DateTime?                  @map("last_outbound_at")
  expiresAt           DateTime                   @map("expires_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  conversionSession ConversionSession? @relation(fields: [conversionSessionId], references: [id])
  messages          WhatsAppMessageEvent[]

  @@index([provider, phoneNumber, status])
  @@map("whatsapp_conversations")
}

model WhatsAppMessageEvent {
  id               String           @id @default(uuid())
  conversationId   String           @map("conversation_id")
  direction        MessageDirection
  providerMessageId String          @unique @map("provider_message_id")
  body             String
  messageType      String           @default("text") @map("message_type")
  provider         MessagingProvider @default(WHATSAPP_CLOUD)
  rawPayload       Json?            @map("raw_payload")
  createdAt        DateTime         @default(now()) @map("created_at")

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId])
  @@map("whatsapp_message_events")
}

model MessagingEvent {
  id                   String               @id @default(uuid())
  provider             MessagingProvider
  providerAccountId    String?              @map("provider_account_id")
  providerEventId      String               @map("provider_event_id")
  providerMessageId    String?              @map("provider_message_id")
  conversationExternalId String             @map("conversation_external_id")
  senderExternalId     String               @map("sender_external_id")
  eventType            MessagingEventType   @map("event_type")
  eventStatus          MessagingEventStatus @default(RECEIVED) @map("event_status")
  occurredAt           DateTime             @map("occurred_at")
  checksum             String
  idempotencyKey       String               @unique @map("idempotency_key")
  correlationId        String?              @map("correlation_id")
  causationId          String?              @map("causation_id")
  payloadJson          Json                 @map("payload_json")
  rawPayloadRef        String               @map("raw_payload_ref")
  retryCount           Int                  @default(0) @map("retry_count")
  nextRetryAt          DateTime?            @map("next_retry_at")
  lastErrorType        String?              @map("last_error_type")
  lastErrorMessage     String?              @map("last_error_message")
  processedAt          DateTime?            @map("processed_at")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  deliveryAttempts MessagingDeliveryAttempt[]
  deadLetters      MessagingDeadLetter[]

  @@unique([provider, providerEventId], name: "messaging_event_provider_provider_event_id_key")
  @@index([provider, providerMessageId])
  @@index([eventStatus, nextRetryAt])
  @@map("messaging_events")
}

model MessagingDeliveryAttempt {
  id                String                @id @default(uuid())
  messagingEventId  String                @map("messaging_event_id")
  provider          MessagingProvider
  conversationId    String?               @map("conversation_id")
  correlationId     String?               @map("correlation_id")
  attemptNumber     Int                   @map("attempt_number")
  retryable         Boolean               @default(false)
  errorType         String?               @map("error_type")
  errorMessage      String?               @map("error_message")
  providerMessageId String?               @map("provider_message_id")
  state             MessagingDeliveryState @default(SENT)
  nextRetryAt       DateTime?             @map("next_retry_at")
  createdAt         DateTime              @default(now()) @map("created_at")

  messagingEvent MessagingEvent @relation(fields: [messagingEventId], references: [id], onDelete: Cascade)

  @@index([messagingEventId, attemptNumber])
  @@map("messaging_delivery_attempts")
}

model MessagingDeadLetter {
  id                String   @id @default(uuid())
  messagingEventId  String   @map("messaging_event_id")
  provider          MessagingProvider
  conversationId    String?  @map("conversation_id")
  correlationId     String   @map("correlation_id")
  payloadRef        String   @map("payload_ref")
  lastErrorType     String   @map("last_error_type")
  lastErrorMessage  String   @map("last_error_message")
  replayHint        String?  @map("replay_hint")
  status            String   @default("OPEN")
  resolvedAt        DateTime? @map("resolved_at")
  createdAt         DateTime @default(now()) @map("created_at")

  messagingEvent MessagingEvent @relation(fields: [messagingEventId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("messaging_dead_letters")
}

model MessagingTemplateDispatch {
  id                 String            @id @default(uuid())
  provider           MessagingProvider
  conversationId     String?           @map("conversation_id")
  templateKey        String            @map("template_key")
  providerTemplateId String?           @map("provider_template_id")
  providerMessageId  String?           @map("provider_message_id")
  correlationId      String?           @map("correlation_id")
  payloadJson        Json?             @map("payload_json")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([provider, conversationId, createdAt])
  @@map("messaging_template_dispatches")
}

model TrackingLinkDispatch {
  id                String            @id @default(uuid())
  provider          MessagingProvider
  conversationId    String?           @map("conversation_id")
  conversionSessionId String?         @map("conversion_session_id")
  referenceCode     String            @map("reference_code")
  trackingUrl       String            @map("tracking_url")
  providerMessageId String?           @map("provider_message_id")
  correlationId     String?           @map("correlation_id")
  status            String            @default("SENT")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([conversionSessionId, createdAt])
  @@map("tracking_link_dispatches")
}

// ─── Daraja & DFNS Tracking Models ────────────────────────────────

model DarajaRequest {
  id                String   @id @default(uuid())
  externalId        String   @unique @map("external_id")
  checkoutRequestId String   @unique @map("checkout_request_id")
  amount            BigInt
  status            String   @default("PENDING")
  rawPayload        Json?    @map("raw_payload")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("daraja_requests")
}

model DfnsRequest {
  id            String   @id @default(uuid())
  externalId    String   @unique @map("external_id")
  dfnsRequestId String?  @unique @map("dfns_request_id")
  dfnsTxId      String?  @map("dfns_tx_id")
  status        String   @default("PENDING")
  rawPayload    Json?    @map("raw_payload")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("dfns_requests")
}

model ProcessedWebhook {
  id          String   @id @default(uuid())
  source      String
  externalId  String   @map("external_id")
  processedAt DateTime @default(now()) @map("processed_at")

  @@unique([source, externalId], name: "source_external_id_unique")
  @@map("processed_webhooks")
}

// ─── PSBT Signing Metadata ───────────────────────────────────

model PayoutPsbt {
  id               String   @id @default(uuid())
  externalId       String   @unique @map("external_id")
  psbtBase64       String   @map("psbt_base64")
  psbtStatus       String   @default("unsigned") @map("psbt_status") // unsigned | signing_pending | signed | broadcast | settled | failed
  psbtId           String?  @map("psbt_id")       // Bria batch ID
  dfnsRequestId    String?  @map("dfns_request_id")
  signedPsbtBase64 String?  @map("signed_psbt_base64")
  txid             String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("payout_psbts")
}
