{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.nx/**": true,
    "**/dist/**": true,
    "**/tmp/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/out-tsc/**": true,
    "**/coverage/**": true,
    "**/.next/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.nx": true,
    "**/out-tsc": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/tmp": true,
    "**/.nx": true,
    "**/out-tsc": true,
    "**/coverage": true,
    "**/.next": true,
    "**/pnpm-lock.yaml": true
  },
  "typescript.tsserver.maxTsServerMemory": 1536,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling"
  }
}
